{
  "name": "@workspace/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then env -u EXPO_TOKEN pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && CI=0 EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN exec env -u EXPO_TOKEN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:search": "../../scripts/node_modules/.bin/tsx --test lib/property-search.test.mjs",
    "test:assets": "../../scripts/node_modules/.bin/tsx --test lib/login-illustration.test.mjs",
    "test:offline": "../../scripts/node_modules/.bin/tsx --test lib/agency-listings-cache.test.mjs lib/offline-listings-cache.test.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
