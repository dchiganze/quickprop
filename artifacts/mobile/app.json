{
  "expo": {
    "name": "QuickProp Agent",
    "slug": "mobile",
    "version": "1.0.0",
    "supportUrl": "https://www.quickprop.melios.co.zw/mobile",
    "marketingUrl": "https://www.quickprop.melios.co.zw/app",
    "copyright": "© 2026 QuickProp (Pvt) Ltd",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickpropagent",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "jsEngine": "jsc",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quickprop.agent",
      "buildNumber": "34",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "QuickProp Agent uses the camera to capture property photos for listings.",
        "NSPhotoLibraryUsageDescription": "QuickProp Agent accesses your photo library to attach property images to listings.",
        "NSLocationWhenInUseUsageDescription": "QuickProp Agent uses your location to show nearby properties and leads.",
        "NSLocationAlwaysUsageDescription": "QuickProp Agent uses your location to show nearby properties and leads.",
        "NSContactsUsageDescription": "QuickProp Agent accesses contacts to help you manage client leads.",
        "NSMicrophoneUsageDescription": "QuickProp Agent uses the microphone for voice notes on property listings."
      }
    },
    "android": {
      "package": "zw.co.melios.quickprop.agent",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withNoHermes",
      "./plugins/withDeploymentTarget",
      "./plugins/withExpoPrintPod",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "401996cd-cac1-4197-ba22-dfca22b2cff8"
      },
      "router": {
        "origin": "https://replit.com/"
      }
    }
  }
}